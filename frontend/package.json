{
  "name": "hello-world",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev",
    "dev:normal": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:view": "node view-users.js",
    "db:test": "node test-db.js",
    "setup": "./setup.sh",
    "setup:manual": "pnpm install",
    "docker:build": "docker build -t car-rental-app .",
    "docker:run": "docker run -p 3000:3000 car-rental-app",
    "docker:dev": "docker-compose up --build",
    "docker:dev-alt": "docker-compose -f docker-compose.alt.yml up --build",
    "docker:stop": "docker-compose down",
    "docker:stop-alt": "docker-compose -f docker-compose.alt.yml down",
    "docker:logs": "docker-compose logs -f"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.0",
    "gsap": "^3.13.0",
    "install": "^0.13.0",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.544.0",
    "next": "^15.5.4",
    "nodemailer": "^7.0.9",
    "npm": "^11.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.60.0",
    "recharts": "2.15.4",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5"
  }
}
